
input {

  keyboard {
    xkb {
      layout "de"
      options "caps:escape,grp:shifts_toggle"
      // options "caps:escape,grp:shifts_toggle,altwin:swap_alt_win,lv3:switch"
    }

    repeat-delay 300
    repeat-rate 25
    // track-layout "global"
    numlock
  }

  touchpad {
    // off
    tap
    dwt
    // drag false
    // drag-lock
    natural-scroll
    // accel-speed 0.2
    // accel-profile "flat"
    // scroll-method "two-finger"
    // disabled-on-external-mouse
  }

  mouse {
    // off
    // natural-scroll
    // accel-speed 0.2
    // accel-profile "flat"
    // scroll-method "no-scroll"
    scroll-button 273
  }

  warp-mouse-to-focus
  focus-follows-mouse max-scroll-amount="0%"
  workspace-auto-back-and-forth
}

spawn-at-startup "noctalia"

environment {
  XDG_CURRENT_DESKTOP "niri"
}
hotkey-overlay {
  skip-at-startup
}

include "binds.kdl"
include "noctalia.kdl"
